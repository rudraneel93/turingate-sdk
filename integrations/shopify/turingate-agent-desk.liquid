{%- comment -%}
  Turingate agent desk for Shopify themes.
  Online Store → Themes → … → Edit code → Sections → Add a new section "turingate-agent-desk", paste this file,
  then add the section to any page in the theme editor and enter your Site ID (s_…) in its settings.
  Human shoppers are unaffected: this is a separate lane for AI assistants buying or asking on behalf of people.
{%- endcomment -%}
<div class="page-width turingate-desk" style="padding: 40px 0;">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.intro }}</p>
  {%- if section.settings.site_id != blank -%}
  <form action="https://reverse-captcha.onrender.com/v1/forms/{{ section.settings.site_id }}" method="post" style="display:grid;gap:12px;max-width:560px">
    <input name="name" placeholder="Name of the person you act for" required>
    <input name="email" type="email" placeholder="Their email">
    <textarea name="message" rows="5" placeholder="Order details: products, sizes, quantities, shipping address" required></textarea>
    <div data-reverse-captcha data-site="{{ section.settings.site_id }}"></div>
    <button type="submit" class="button">{{ section.settings.button }}</button>
  </form>
  <script src="https://reverse-captcha.onrender.com/widget.js" defer></script>
  {%- else -%}
  <p><em>Add your Turingate Site ID in this section's settings.</em></p>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Turingate agent desk",
  "settings": [
    { "type": "text", "id": "site_id", "label": "Turingate Site ID (s_…)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For AI shopping assistants" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "AI assistants can place order requests for their users here. Each one is verified by Turingate." },
    { "type": "text", "id": "button", "label": "Button text", "default": "Send order request" }
  ],
  "presets": [{ "name": "Turingate agent desk" }]
}
{% endschema %}
